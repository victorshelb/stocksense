ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
PORT=3003

# ── NEW: Finnhub — 60 API calls/minute FREE ──
# Sign up at https://finnhub.io → Dashboard → copy API Key
# Provides: news, analyst ratings, insider trading, earnings history, key metrics
FINNHUB_API_KEY=your_finnhub_key_here

# ── NEW: Financial Modeling Prep — 250 calls/day FREE ──
# Sign up at https://financialmodelingprep.com → Dashboard → copy API Key
# Provides: income statements, balance sheets, cash flows, dividends, ratios
FMP_API_KEY=your_fmp_key_here

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Email — Option A: Gmail (recommended for quick setup)
# 1. Enable 2-Factor Auth on your Gmail account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate an App Password for "Mail"
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email — Option B: Custom SMTP (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# The base URL of the app (used in verification + digest email links).
# Production single-server mode serves everything on 3003.
APP_URL=http://localhost:3003

# Admin: the account whose email matches this becomes the admin (can view/
# manage users at /admin). Set it to YOUR email.
ADMIN_EMAIL=you@example.com

# Secret for triggering bulk digest send (POST /api/email/send-all)
EMAIL_TRIGGER_SECRET=change-this-too
